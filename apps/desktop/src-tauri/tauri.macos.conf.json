{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Mini Office",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "fileAssociations": [
      {
        "ext": [
          "docx",
          "dotx"
        ],
        "name": "Word 文档",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "xlsx",
          "csv"
        ],
        "name": "电子表格",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "pptx",
          "potx"
        ],
        "name": "PowerPoint 演示文稿",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "docm",
          "xlsm",
          "pptm"
        ],
        "name": "含宏 Office 文档（只读）",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
